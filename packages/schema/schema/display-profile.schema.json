{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "display-profile"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "displayName": {
      "type": "string"
    },
    "logicalSize": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "shape": {
      "type": "string",
      "enum": [
        "rect",
        "round"
      ]
    },
    "colorFormat": {
      "type": "string",
      "enum": [
        "RGB565",
        "RGB565_SWAPPED",
        "RGB888",
        "XRGB8888",
        "ARGB8888",
        "L8",
        "I1"
      ]
    },
    "dpi": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "visibleRect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "installRotation": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 90
        },
        {
          "type": "number",
          "const": 180
        },
        {
          "type": "number",
          "const": 270
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "logicalSize",
    "shape",
    "colorFormat"
  ],
  "additionalProperties": false
}
