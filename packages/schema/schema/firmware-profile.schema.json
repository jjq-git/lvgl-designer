{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "firmware-profile"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "displayName": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "uiAbiVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "capabilityRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "supportedWidgets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportedSubjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lvConf": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "memoryBudgetBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "target",
    "uiAbiVersion",
    "capabilityRevision",
    "supportedWidgets",
    "supportedSubjects",
    "supportedActions"
  ],
  "additionalProperties": false
}
