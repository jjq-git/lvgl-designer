<screen>
    <view width="466" height="466" style_bg_color="0x000000">
        <lv_arc name="arc_vol" width="400" height="400" align="center" bind_value="volume"/>
        <lv_label name="lbl_vol" align="center" bind_text="volume" bind_text-fmt="Vol: %d">
            <lv_obj-bind_flag_if_gt subject="volume" flag="hidden" ref_value="90"/>
        </lv_label>
        <lv_switch name="sw_mute" y="-40" align="bottom_mid" bind_checked="muted"/>
        <lv_button name="btn_up" x="20" y="20">
            <lv_obj-bind_state_if_ge subject="volume" state="disabled" ref_value="100"/>
            <lv_obj-subject_increment_event trigger="clicked" subject="volume" step="5" min_value="0" max_value="100" rollover="false"/>
            <lv_obj-event_cb trigger="long_pressed" callback="on_up_long" user_data="fast"/>
        </lv_button>
        <lv_button name="btn_reset" x="20" y="80">
            <lv_obj-subject_set_int_event trigger="clicked" subject="volume" value="30"/>
            <lv_obj-subject_toggle_event trigger="double_clicked" subject="muted"/>
        </lv_button>
        <lv_button name="btn_settings" x="20" y="140">
            <lv_obj-screen_load_event trigger="clicked" screen="settings" anim_type="over_right" duration="300" delay="0"/>
        </lv_button>
    </view>
</screen>
