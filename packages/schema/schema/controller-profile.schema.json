{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "controller-profile"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "displayRef": {
      "type": "string",
      "pattern": "^display:[a-z0-9][a-z0-9._-]*@[1-9]\\d*$"
    },
    "frame": {
      "type": "object",
      "properties": {
        "assetRef": {
          "type": "string",
          "pattern": "^asset:.+@sha256:[0-9a-f]{8,64}$"
        },
        "viewBox": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        },
        "screenViewport": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "rotation": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 0
                },
                {
                  "type": "number",
                  "const": 90
                },
                {
                  "type": "number",
                  "const": 180
                },
                {
                  "type": "number",
                  "const": 270
                }
              ]
            },
            "clip": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "none"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "rect"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "roundedRect"
                    },
                    "radius": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "type",
                    "radius"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "circle"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height",
            "rotation"
          ]
        }
      },
      "required": [
        "assetRef",
        "viewBox",
        "screenViewport"
      ],
      "additionalProperties": false
    },
    "inputProfileRef": {
      "type": "string",
      "pattern": "^input:[a-z0-9][a-z0-9._-]*@[1-9]\\d*$"
    },
    "physicalControls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "knob",
              "button",
              "switch"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "hitArea": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "action": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "hitArea"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "revision",
    "model",
    "displayRef",
    "frame"
  ],
  "additionalProperties": false
}
