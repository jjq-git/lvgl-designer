# 首次启动管理员。初始化后账号保存在 auth_data/auth.db。
AUTH_BOOTSTRAP_ADMIN=admin
AUTH_BOOTSTRAP_PASSWORD=admin123
AUTH_SESSION_COOKIE=lvd_session
AUTH_SESSION_TTL_DAYS=7

# AI 功能。也可在设计器 AI 设置中临时输入 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 正式构建校验。none 适合无 CMake/LVGL 工具链的本地开发。
LVGL_BUILD_COMPILE_GATE=none
LVGL_BUILD_TIMEOUT_SECONDS=60
